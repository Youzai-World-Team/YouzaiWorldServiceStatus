{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youzaiworld-service-status",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}

